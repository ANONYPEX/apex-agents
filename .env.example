# Credenciales OAuth2 de Google Cloud (tipo "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Supabase: Project Settings > API en supabase.com
# Usa la service role key (no la anon key) porque estas llamadas son server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
